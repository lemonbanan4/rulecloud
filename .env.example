# Server
PORT=8000
LOG_LEVEL=INFO

# CORS — production frontend origin (localhost:3000 is always allowed)
FRONTEND_URL=https://your-frontend.example.com

# GitHub App / webhook
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-secret

# Optional: GitHub PAT for future Check Runs / PR comment posting (not required for scan-only)
# GITHUB_TOKEN=ghp_...

# Guardrail CLI
GUARDRAIL_BIN=guardrail
# Extra args appended to: guardrail scan .
# GUARDRAIL_ARGS=--json --severity high
GUARDRAIL_TIMEOUT_SEC=60
GIT_CLONE_TIMEOUT_SEC=30