# Local Cursor MCP (see .cursor/mcp.json) — create key in console, never commit the value
# RULECLOUD_API_KEY=rc_live_...

# Server
PORT=8000
LOG_LEVEL=INFO

# CORS — localhost:3000 is always allowed; set your deployed frontend origin (not *)
FRONTEND_URL=https://rulecloud.vercel.app

# GitHub App / webhook
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-secret
BACKEND_URL=https://rulecloud-production.up.railway.app
# Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# or any long random string (hashed to Fernet) to encrypt stored GitHub PATs at rest
TOKEN_ENCRYPTION_KEY=
# Legacy alias — use TOKEN_ENCRYPTION_KEY in new deploys
GITHUB_TOKEN_ENC_KEY=change-me-long-random-string

# Optional: GitHub PAT for future Check Runs / PR comment posting (not required for scan-only)
# GITHUB_TOKEN=ghp_...

# MoeidHeidari/guardrail CLI (built in Docker)
GUARDRAIL_BIN=guardrail
# Extra args after: guardrail check . --format json
# GUARDRAIL_ARGS=--context .
GUARDRAIL_TIMEOUT_SEC=60
GIT_CLONE_TIMEOUT_SEC=30

# Supabase (persistence + JWT auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Dashboard → Project Settings → API → JWT Secret (HS256, audience authenticated)
SUPABASE_JWT_SECRET=your-jwt-secret

# Anonymous demo scans (per IP per hour); 0 = disabled
ANONYMOUS_SCAN_LIMIT_PER_HOUR=10

# Stripe (Pro billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# AI Copilot (openai or gemini)
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SEC=60
# AI_GENERATE_FREE_DAILY_LIMIT=15